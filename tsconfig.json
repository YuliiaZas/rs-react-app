{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "target": "ES2021",
    "useDefineForClassFields": true,
    "lib": [
      "ES2021",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "baseUrl": "src/",
    "paths": {
      "@layout": [
        "components/layout/index.ts"
      ],
      "@error-boundary": [
        "components/error-boundary/index.ts"
      ],
      "@lib": [
        "components/lib/index.ts"
      ],
      "@home-components": [
        "components/home-components/index.ts"
      ],
      "@context": [
        "context/index.ts"
      ],
      "@hooks": [
        "hooks/index.ts"
      ],
      "@mock": [
        "mock/index.ts"
      ],
      "@store": [
        "store/index.ts"
      ],
      "@services": [
        "services/index.ts"
      ],
      "@utils": [
        "utils/index.ts"
      ]
    },
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "preserve",
    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "allowJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "resolveJsonModule": true
  },
  "include": [
    "./dist/types/**/*.ts",
    "./next-env.d.ts",
    "src",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "./node_modules"
  ]
}
